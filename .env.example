# Copy this file to .env. Never put the Gemini key in the browser or source control.
GEMINI_API_KEY=
# Configurable; this is the model in Google's documentation checked 2026-10-04.
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
HOST=127.0.0.1
# Required when exposing a key-enabled app beyond localhost.
# Share this reviewer password separately from the public URL.
APP_ACCESS_TOKEN=
# Global limits for this one-process MVP; each indexed photo is one AI call.
AI_REQUESTS_PER_HOUR=120
AI_MAX_CONCURRENT=2
AI_TIMEOUT_MS=45000
